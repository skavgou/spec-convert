{
  "document" : {
    "dsl" : "1.0.0",
    "namespace" : "default",
    "name" : "helloworld",
    "version" : "1.0"
  },
  "do" : [ {
    "SleepFiveSeconds" : {
      "wait" : {
        "seconds" : 5
      }
    }
  }, {
    "Hello State" : {
      "set" : {
        "result" : "Hello World!"
      }
    }
  }, {
    "CheckApplicant" : {
      "switch" : [ {
        "applicantIsAdult" : {
          "when" : "fn:isAdult",
          "then" : "ApproveApplication"
        }
      }, {
        "applicantIsMinor" : {
          "when" : "fn:isMinor",
          "then" : "RejectApplication"
        }
      }, {
        "default" : {
          "then" : "RejectApplication"
        }
      } ]
    }
  } ]
}
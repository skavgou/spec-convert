{
  "id": "applicationprocessing",
  "version": "1.0",
  "specVersion": "0.8",
  "name": "Application Processing Workflow",
  "description": "Check an applicant and send rejection email if needed",
  "start": "CheckApplicant",
  "states": [
    {
      "name": "CheckApplicant",
      "type": "switch",
      "dataConditions": [
        {
          "name": "Applicant is adult",
          "condition": "${ .applicant.age >= 18 }",
          "transition": "ApproveApplication"
        }
      ],
      "defaultCondition": {
        "transition": "RejectApplication"
      }
    },
    {
      "name": "RejectApplication",
      "type": "operation",
      "actionMode": "sequential",
      "actions": [
        {
          "functionRef": {
            "refName": "sendRejectionEmailFunction",
            "arguments": {
              "customer": "${ .customer }"
            }
          }
        }
      ],
      "end": true
    },
    {
      "name": "ApproveApplication",
      "type": "operation",
      "actionMode": "sequential",
      "actions": [
        {
          "functionRef": {
            "refName": "sendApprovalEmailFunction",
            "arguments": {
              "customer": "${ .customer }"
            }
          }
        },
        {
          "functionRef": {
            "refName": "updateApplicationStatusFunction",
            "arguments": {
              "applicationId": "${ .applicationId }",
              "status": "approved"
            }
          }
        }
      ],
      "end": true
    },
    {
      "name": "NotifyParallel",
      "type": "operation",
      "actionMode": "parallel",
      "actions": [
        {
          "functionRef": {
            "refName": "sendEmailNotificationFunction",
            "arguments": {
              "customer": "${ .customer }"
            }
          }
        },
        {
          "functionRef": {
            "refName": "sendSMSNotificationFunction",
            "arguments": {
              "customer": "${ .customer }"
            }
          }
        }
      ],
      "end": true
    }
  ]
}
